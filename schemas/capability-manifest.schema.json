{
  "$defs": {
    "CapabilityDefinition": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "title": "Applicability",
          "type": "string"
        },
        "completion_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Completion Evidence",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/CapabilityEvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "implementation_ref": {
          "title": "Implementation Ref",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "introduced_generation": {
          "title": "Introduced Generation",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CapabilityKind"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "owner_component": {
          "title": "Owner Component",
          "type": "string"
        },
        "proof_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProofClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "semantic_effects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Effects",
          "type": "array"
        }
      },
      "required": [
        "name",
        "purpose",
        "kind",
        "owner_component",
        "applicability",
        "implementation_ref",
        "evidence_state",
        "proof_class",
        "introduced_generation"
      ],
      "title": "CapabilityDefinition",
      "type": "object"
    },
    "CapabilityEvidenceRef": {
      "additionalProperties": false,
      "description": "Opaque, content-addressed support for one capability claim.\n\nThe referenced artifact carries detailed evidence externally. Capability\nsemantics never copy incident prose, target names, command IDs, or\nincident-specific mechanics into this generic contract.",
      "properties": {
        "authority_ref": {
          "minLength": 1,
          "title": "Authority Ref",
          "type": "string"
        },
        "content_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "proof_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProofClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authority_ref",
        "content_digest",
        "evidence_state",
        "proof_class"
      ],
      "title": "CapabilityEvidenceRef",
      "type": "object"
    },
    "CapabilityKind": {
      "enum": [
        "sensing",
        "representation",
        "memory",
        "action",
        "verification",
        "recovery"
      ],
      "title": "CapabilityKind",
      "type": "string"
    },
    "EvidenceState": {
      "description": "How far a capability's evidence supports offering it.\n\n``proof_class`` is intentionally a separate, nullable axis.  A capability\nmay be declared but absent, unproven, withheld, unknown, or unsupported\nwithout being accidentally certified by a default proof class.",
      "enum": [
        "proven",
        "absent",
        "unproven",
        "withheld",
        "unknown",
        "unsupported"
      ],
      "title": "EvidenceState",
      "type": "string"
    },
    "ProofClass": {
      "enum": [
        "synthetic",
        "portable",
        "replay",
        "live"
      ],
      "title": "ProofClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityDefinition"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    }
  },
  "required": [
    "generation_id",
    "capabilities"
  ],
  "title": "CapabilityManifest",
  "type": "object"
}
