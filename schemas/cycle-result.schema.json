      "title": "CandidateManifest",
      "type": "object"
    },
    "CandidateStatus": {
      "enum": [
        "created",
        "reviewed",
        "evaluated",
        "retained",
        "rejected"
      ],
      "title": "CandidateStatus",
      "type": "string"
    },
