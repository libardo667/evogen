{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A typed reference to one immutable content-addressed artifact.",
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "model"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidateManifest": {
      "additionalProperties": false,
      "properties": {
        "artifact_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Artifact Digests",
          "type": "object"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "changed_files": {
          "items": {
            "type": "string"
          },
          "title": "Changed Files",
          "type": "array"
        },
        "claimed_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Claimed Capabilities",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "file_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "File Digests",
          "type": "object"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "parent_generation": {
          "title": "Parent Generation",
          "type": "string"
        },
        "source_digest": {
          "title": "Source Digest",
          "type": "string"
        },
        "spec_id": {
          "title": "Spec Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CandidateStatus",
          "default": "created"
        },
        "workspace_file_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Workspace File Digests",
          "type": "object"
        },
        "workspace_path": {
          "title": "Workspace Path",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "parent_generation",
        "issue_id",
        "spec_id",
        "workspace_path",
        "source_digest",
        "artifact_digests",
        "changed_files",
        "claimed_capabilities",
        "workspace_file_digests"
