        "candidate_metrics": {
          "$ref": "#/$defs/MetricVector"
        },
        "candidate_results": {
          "items": {
            "$ref": "#/$defs/ScenarioResult"
          },
          "title": "Candidate Results",
          "type": "array"
        },
        "candidate_subject_metrics": {
          "items": {
            "$ref": "#/$defs/SubjectMetricVector"
