{
  "$defs": {
    "MetricVector": {
      "additionalProperties": false,
      "properties": {
        "average_steps": {
          "minimum": 0.0,
          "title": "Average Steps",
          "type": "number"
        },
        "blocked_run_count": {
          "minimum": 0,
          "title": "Blocked Run Count",
          "type": "integer"
        },
        "intervention_count": {
          "minimum": 0,
          "title": "Intervention Count",
          "type": "integer"
        },
        "invalid_action_count": {
          "minimum": 0,
          "title": "Invalid Action Count",
          "type": "integer"
        },
        "long_horizon_success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Long Horizon Success Rate",
          "type": "number"
        },
        "new_high_severity_issues": {
          "default": 0,
          "minimum": 0,
          "title": "New High Severity Issues",
          "type": "integer"
        },
        "regression_success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Regression Success Rate",
          "type": "number"
        },
        "revealing_success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Revealing Success Rate",
          "type": "number"
        },
        "variant_success_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Variant Success Rate",
          "type": "number"
        }
      },
      "required": [
        "revealing_success_rate",
        "variant_success_rate",
        "regression_success_rate",
        "long_horizon_success_rate",
        "intervention_count",
        "invalid_action_count",
        "blocked_run_count",
        "average_steps"
      ],
      "title": "MetricVector",
      "type": "object"
    },
    "ScenarioResult": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "elapsed_seconds": {
          "minimum": 0.0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "interventions": {
          "title": "Interventions",
          "type": "integer"
        },
        "invalid_actions": {
          "title": "Invalid Actions",
          "type": "integer"
        },
        "repeat_index": {
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "termination": {
          "title": "Termination",
          "type": "string"
        },
        "trace_digest": {
          "title": "Trace Digest",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "category",
        "seed",
        "repeat_index",
        "elapsed_seconds",
        "success",
        "steps",
        "interventions",
        "invalid_actions",
        "blocked",
        "termination",
        "run_id",
        "trace_digest"
      ],
      "title": "ScenarioResult",
      "type": "object"
    },
    "SubjectMetricVector": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "metrics"
      ],
      "title": "SubjectMetricVector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_generation": {
      "title": "Baseline Generation",
      "type": "string"
    },
    "baseline_metrics": {
      "$ref": "#/$defs/MetricVector"
    },
    "baseline_results": {
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      },
      "title": "Baseline Results",
      "type": "array"
    },
    "baseline_subject_metrics": {
      "items": {
        "$ref": "#/$defs/SubjectMetricVector"
      },
      "minItems": 1,
      "title": "Baseline Subject Metrics",
      "type": "array"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_metrics": {
      "$ref": "#/$defs/MetricVector"
    },
    "candidate_results": {
      "items": {
        "$ref": "#/$defs/ScenarioResult"
      },
      "title": "Candidate Results",
      "type": "array"
    },
    "candidate_subject_metrics": {
      "items": {
        "$ref": "#/$defs/SubjectMetricVector"
      },
      "minItems": 1,
      "title": "Candidate Subject Metrics",
      "type": "array"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "prediction_matched": {
      "title": "Prediction Matched",
      "type": "boolean"
    },
    "review_passed": {
      "title": "Review Passed",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "candidate_id",
    "baseline_generation",
    "started_at",
    "finished_at",
    "baseline_results",
    "candidate_results",
    "baseline_metrics",
    "candidate_metrics",
    "prediction_matched",
    "review_passed",
    "baseline_subject_metrics",
    "candidate_subject_metrics"
  ],
  "title": "EvaluationOutcome",
  "type": "object"
}
