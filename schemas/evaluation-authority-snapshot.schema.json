        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "model"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluator_version": {
      "title": "Evaluator Version",
      "type": "string"
    },
    "protected_path_digests": {
      "additionalProperties": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Protected Path Digests",
      "type": "object"
    },
    "suite_id": {
      "title": "Suite Id",
      "type": "string"
    },
    "suite_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
