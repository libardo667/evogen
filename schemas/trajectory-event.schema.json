{
  "$defs": {
    "EventKind": {
      "enum": [
        "run_started",
        "observation",
        "observation_delta",
        "affordance_set",
        "decision",
        "binding",
        "dispatch",
        "execution_receipt",
        "outcome_observation",
        "memory_update",
        "human_intervention",
        "recovery",
        "error",
        "goal_blocked",
        "goal_achieved",
        "run_finished"
      ],
      "title": "EventKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "envelope_version": {
      "const": "1.0",
      "title": "Envelope Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Event Id"
    },
    "source_event_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Event Type"
    },
    "source_sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Sequence"
    },
    "source_step_index": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Step Index"
    },
    "source_world_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source World Revision"
    },
    "world_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "World Revision"
    }
  },
  "required": [
    "envelope_version",
    "event_id",
    "run_id",
    "generation_id",
    "scenario_id",
    "sequence",
    "kind",
    "source_event_type",
    "source_event_id",
    "source_sequence",
    "source_step_index",
    "source_world_revision"
  ],
  "title": "TrajectoryEvent",
  "type": "object"
}
