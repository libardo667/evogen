{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A typed reference to one immutable content-addressed artifact.",
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "digest",
        "model"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        },
        "generation_id": {
          "title": "Generation Id",
          "type": "string"
        },
        "interventions": {
          "default": 0,
          "title": "Interventions",
          "type": "integer"
        },
        "invalid_actions": {
          "default": 0,
          "title": "Invalid Actions",
          "type": "integer"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "termination": {
          "title": "Termination",
          "type": "string"
        },
        "trace_digest": {
          "title": "Trace Digest",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "generation_id",
        "scenario_id",
        "started_at",
        "finished_at",
        "success",
        "termination",
        "trace_digest",
        "steps"
      ],
      "title": "RunRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "capability_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "cycle_id": {
      "title": "Cycle Id",
      "type": "string"
    },
    "event_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Event Refs",
      "type": "array"
    },
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "plan_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "run_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Run Refs",
      "type": "array"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunRecord"
      },
      "title": "Runs",
      "type": "array"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    }
  },
  "required": [
    "cycle_id",
    "subject",
    "generation_id",
    "baseline_ref",
    "plan_ref",
    "capability_ref",
    "run_refs",
    "event_refs",
    "runs"
  ],
  "title": "IngestResult",
  "type": "object"
}
